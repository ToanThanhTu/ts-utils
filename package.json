{
  "name": "@trevortu/ts-utils",
  "version": "0.3.0",
  "description": "A type-safe Typescript utility library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "type": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "publint && attw --pack",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "keywords": [
    "typescript",
    "utility",
    "library"
  ],
  "author": "Trevor Tu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToanThanhTu/ts-utils.git"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
